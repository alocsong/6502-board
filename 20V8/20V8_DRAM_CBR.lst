Created Wed Nov 11 14:10:38 2026

108:REF_ACK = (S1 & !S0 & T1 & T0) ;
109:
110:/* ---------- Individual OLMC output enable: permanently enable these combinatorial I/O outputs ---------- */
111:LOAD14.OE = VCC ;
112:LOAD8.OE  = VCC ;
113:CPU_CLK.OE = VCC ;
114:CHAR_CLK.OE = VCC ;
115:DRAM_RAS.OE = VCC ;
116:DRAM_CAS.OE = VCC ;
117:DRAM_WE.OE = VCC ;
118:DRAM_OE.OE = VCC ;
119:ADDR_MUX_SEL.OE = VCC ;
120:REF_ACK.OE = VCC ;
121:



